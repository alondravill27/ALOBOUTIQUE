<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ALOBOUTIQUE.Views.PosPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:ALOBOUTIQUE.ViewModels"
    xmlns:m="clr-namespace:ALOBOUTIQUE.Models"
    x:DataType="vm:PosViewModel"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{StaticResource White}">

    <ContentPage.BindingContext>
        <vm:PosViewModel/>
    </ContentPage.BindingContext>

    <Grid ColumnDefinitions="52,*" RowDefinitions="*">

        <Grid
            Grid.Column="0"
            RowDefinitions="Auto,*,Auto"
            BackgroundColor="{StaticResource PinkGhost}"
            Padding="6,10">

            <Label
                Grid.Row="0"
                Text="A"
                FontFamily="CormorantGaramond-BoldItalic"
                FontSize="22"
                TextColor="{StaticResource PinkDeep}"
                HorizontalOptions="Center"
                Margin="0,4,0,10"/>

            <VerticalStackLayout Grid.Row="1" Spacing="4">

                <Border Style="{StaticResource NavItemActiveStyle}"
                        WidthRequest="40" HeightRequest="40"
                        HorizontalOptions="Center" Padding="0">
                    <Label Text="&#xf291;" FontFamily="MaterialIcons"
                           FontSize="20" TextColor="{StaticResource PinkDeep}"
                           HorizontalOptions="Center" VerticalOptions="Center"/>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnPosNavTapped"/>
                    </Border.GestureRecognizers>
                </Border>

                <Border Style="{StaticResource NavItemStyle}"
                        WidthRequest="40" HeightRequest="40"
                        HorizontalOptions="Center" Padding="0">
                    <Label Text="&#xf02a;" FontFamily="MaterialIcons"
                           FontSize="20" TextColor="{StaticResource TextMuted}"
                           HorizontalOptions="Center" VerticalOptions="Center"/>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnHistorialNavTapped"/>
                    </Border.GestureRecognizers>
                </Border>

                <Border Style="{StaticResource NavItemStyle}"
                        WidthRequest="40" HeightRequest="40"
                        HorizontalOptions="Center" Padding="0">
                    <Label Text="&#xe8f4;" FontFamily="MaterialIcons"
                           FontSize="20" TextColor="{StaticResource TextMuted}"
                           HorizontalOptions="Center" VerticalOptions="Center"/>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnApartadosNavTapped"/>
                    </Border.GestureRecognizers>
                </Border>

                <Border Style="{StaticResource NavItemStyle}"
                        WidthRequest="40" HeightRequest="40"
                        HorizontalOptions="Center" Padding="0">
                    <Label Text="&#xe8d1;" FontFamily="MaterialIcons"
                           FontSize="20" TextColor="{StaticResource TextMuted}"
                           HorizontalOptions="Center" VerticalOptions="Center"/>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnInventarioNavTapped"/>
                    </Border.GestureRecognizers>
                </Border>

                <Border Style="{StaticResource NavItemStyle}"
                       WidthRequest="40" HeightRequest="40"
                       HorizontalOptions="Center" Padding="0">
                    <Label Text="&#xe7fd;" FontFamily="MaterialIcons"
                        FontSize="20" TextColor="{StaticResource TextMuted}"
                        HorizontalOptions="Center" VerticalOptions="Center"/>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnClientesNavTapped"/>
                    </Border.GestureRecognizers>
                </Border>

                <BoxView Style="{StaticResource DividerStyle}" Margin="6,4"/>

                <Border Style="{StaticResource NavItemStyle}"
                        WidthRequest="40" HeightRequest="40"
                        HorizontalOptions="Center" Padding="0">
                    <Label Text="&#xe8cc;" FontFamily="MaterialIcons"
                           FontSize="20" TextColor="{StaticResource TextMuted}"
                           HorizontalOptions="Center" VerticalOptions="Center"/>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnPekaClubNavTapped"/>
                    </Border.GestureRecognizers>
                </Border>

            </VerticalStackLayout>

            <Border Grid.Row="2"
                    Style="{StaticResource AvatarStyle}"
                    HorizontalOptions="Center"
                    Margin="0,0,0,4">
                <Label Text="LP"
                       FontSize="11" FontAttributes="Bold"
                       TextColor="{StaticResource PinkDeep}"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"/>
            </Border>

        </Grid>

        <Grid
            Grid.Column="1"
            ColumnDefinitions="180,*,Auto"
            RowDefinitions="*">

            <Grid
                Grid.Column="0"
                RowDefinitions="Auto,*,Auto"
                BackgroundColor="{StaticResource PinkGhost}">

                <VerticalStackLayout Grid.Row="0"
                    Padding="14,14,14,10"
                    Spacing="2">
                    <Label Text="Aloboutique"
                           Style="{StaticResource BrandStyle}"/>
                    <Label Text="CULIACÁN · POS v2"
                           Style="{StaticResource SectionLabelStyle}"/>
                    <BoxView Style="{StaticResource DividerStyle}" Margin="0,6,0,0"/>
                </VerticalStackLayout>

                <ScrollView Grid.Row="1">
                    <VerticalStackLayout Padding="10,8" Spacing="2">

                        <Label Text="Ventas" Style="{StaticResource SectionLabelStyle}" Margin="4,0,0,4"/>

                        <Border Style="{StaticResource NavItemActiveStyle}">
                            <HorizontalStackLayout Spacing="8">
                                <Label Text="&#xf291;" FontFamily="MaterialIcons"
                                       FontSize="15" TextColor="{StaticResource PinkDeep}"
                                       VerticalOptions="Center"/>
                                <Label Text="Punto de venta"
                                       FontSize="11" FontAttributes="Bold"
                                       TextColor="{StaticResource PinkDeep}"
                                       VerticalOptions="Center"/>
                            </HorizontalStackLayout>
                        </Border>

                        <Border Style="{StaticResource NavItemStyle}">
                            <HorizontalStackLayout Spacing="8">
                                <Label Text="&#xe8b2;" FontFamily="MaterialIcons"
                                       FontSize="15" TextColor="{StaticResource TextMuted}"
                                       VerticalOptions="Center"/>
                                <Label Text="Historial"
                                       FontSize="11" FontAttributes="Bold"
                                       TextColor="{StaticResource TextMain}"
                                       VerticalOptions="Center"/>
                            </HorizontalStackLayout>
                        </Border>

                        <Border Style="{StaticResource NavItemStyle}">
                            <HorizontalStackLayout Spacing="8">
                                <Label Text="&#xe8fc;" FontFamily="MaterialIcons"
                                       FontSize="15" TextColor="{StaticResource TextMuted}"
                                       VerticalOptions="Center"/>
                                <Label Text="Apartados"
                                       FontSize="11" FontAttributes="Bold"
                                       TextColor="{StaticResource TextMain}"
                                       VerticalOptions="Center"/>
                                <Ellipse Fill="{StaticResource PinkDark}"
                                         WidthRequest="7" HeightRequest="7"
                                         VerticalOptions="Center"/>
                            </HorizontalStackLayout>
                        </Border>

                        <Label Text="Catálogo" Style="{StaticResource SectionLabelStyle}"
                               Margin="4,10,0,4"/>

                        <Border Style="{StaticResource NavItemStyle}">
                            <HorizontalStackLayout Spacing="8">
                                <Label Text="&#xe53c;" FontFamily="MaterialIcons"
                                       FontSize="15" TextColor="{StaticResource TextMuted}"
                                       VerticalOptions="Center"/>
                                <Label Text="Productos"
                                       FontSize="11" FontAttributes="Bold"
                                       TextColor="{StaticResource TextMain}"
                                       VerticalOptions="Center"/>
                            </HorizontalStackLayout>
                        </Border>

                        <Border Style="{StaticResource NavItemStyle}">
                            <HorizontalStackLayout Spacing="8">
                                <Label Text="&#xe147;" FontFamily="MaterialIcons"
                                       FontSize="15" TextColor="{StaticResource TextMuted}"
                                       VerticalOptions="Center"/>
                                <Label Text="Inventario"
                                       FontSize="11" FontAttributes="Bold"
                                       TextColor="{StaticResource TextMain}"
                                       VerticalOptions="Center"/>
                            </HorizontalStackLayout>
                        </Border>

                        <Label Text="Clientes" Style="{StaticResource SectionLabelStyle}"
                               Margin="4,10,0,4"/>

                        <Border Style="{StaticResource NavItemStyle}">
                            <HorizontalStackLayout Spacing="8">
                                <Label Text="&#xe7fd;" FontFamily="MaterialIcons"
                                       FontSize="15" TextColor="{StaticResource TextMuted}"
                                       VerticalOptions="Center"/>
                                <Label Text="Peka Club"
                                       FontSize="11" FontAttributes="Bold"
                                       TextColor="{StaticResource TextMain}"
                                       VerticalOptions="Center"/>
                            </HorizontalStackLayout>
                        </Border>

                    </VerticalStackLayout>
                </ScrollView>

                <VerticalStackLayout Grid.Row="2" Padding="10,0,10,12" Spacing="5">

                    <Border Style="{StaticResource CardStyle}" Padding="10,8">
                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                            <Label Grid.Row="0" Grid.Column="0"
                                   Text="Ventas hoy"
                                   Style="{StaticResource CaptionStyle}"/>
                            <Label Grid.Row="1" Grid.Column="0"
                                   Text="{Binding TodaySalesFormatted}"
                                   FontSize="13" FontAttributes="Bold"
                                   TextColor="{StaticResource TextMain}"/>
                            <Label Grid.Row="0" Grid.Column="1"
                                   Grid.RowSpan="2"
                                   Text="&#xe8f1;" FontFamily="MaterialIcons"
                                   FontSize="18" TextColor="{StaticResource PinkLight}"
                                   VerticalOptions="Center"/>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource CardStyle}" Padding="10,8">
                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                            <Label Grid.Row="0" Grid.Column="0"
                                   Text="Transacciones"
                                   Style="{StaticResource CaptionStyle}"/>
                            <Label Grid.Row="1" Grid.Column="0"
                                   Text="{Binding TodayTransactions}"
                                   FontSize="13" FontAttributes="Bold"
                                   TextColor="{StaticResource TextMain}"/>
                            <Label Grid.Row="0" Grid.Column="1"
                                   Grid.RowSpan="2"
                                   Text="&#xe854;" FontFamily="MaterialIcons"
                                   FontSize="18" TextColor="{StaticResource PinkLight}"
                                   VerticalOptions="Center"/>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource CardStyle}" Padding="9">
                        <HorizontalStackLayout Spacing="8">
                            <Border Style="{StaticResource AvatarStyle}">
                                <Label Text="{Binding CashierInitials}"
                                       FontSize="11" FontAttributes="Bold"
                                       TextColor="{StaticResource PinkDeep}"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"/>
                            </Border>
                            <VerticalStackLayout VerticalOptions="Center" Spacing="1">
                                <Label Text="{Binding CashierName}"
                                       FontSize="11" FontAttributes="Bold"
                                       TextColor="{StaticResource TextMain}"/>
                                <Label Text="{Binding CashierRole}"
                                       Style="{StaticResource CaptionStyle}"/>
                            </VerticalStackLayout>
                        </HorizontalStackLayout>
                    </Border>

                </VerticalStackLayout>

            </Grid>

            <Grid
                Grid.Column="1"
                RowDefinitions="Auto,Auto,*,Auto"
                BackgroundColor="{StaticResource White}">

                <Grid Grid.Row="0"
                      ColumnDefinitions="*,Auto,Auto"
                      Padding="18,14,18,10">
                    <VerticalStackLayout Grid.Column="0" Spacing="1">
                        <Label Text="Catálogo"
                               Style="{StaticResource TitleStyle}"/>
                        <Label Text="{Binding ProductCountLabel}"
                               Style="{StaticResource CaptionStyle}"/>
                    </VerticalStackLayout>
                    <Button Grid.Column="1"
                            Text="+ Nuevo"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Margin="0,0,6,0"
                            Command="{Binding NewProductCommand}"/>
                    <Button Grid.Column="2"
                            Text="&#xe145; Agregar"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Command="{Binding AddToCartCommand}"/>
                </Grid>

                <Grid Grid.Row="1"
                      ColumnDefinitions="*,Auto"
                      Padding="18,4,18,8">

                    <ScrollView Grid.Column="0"
                                Orientation="Horizontal"
                                HorizontalScrollBarVisibility="Never">
                        <HorizontalStackLayout Spacing="5">
                            <Button Text="Todos"
                                    Style="{StaticResource FilterChipActiveStyle}"
                                    Command="{Binding FilterCommand}"
                                    CommandParameter="Todos"/>
                            <Button Text="Vestidos"
                                    Style="{StaticResource FilterChipStyle}"
                                    Command="{Binding FilterCommand}"
                                    CommandParameter="Vestidos"/>
                            <Button Text="Blusas"
                                    Style="{StaticResource FilterChipStyle}"
                                    Command="{Binding FilterCommand}"
                                    CommandParameter="Blusas"/>
                            <Button Text="Accesorios"
                                    Style="{StaticResource FilterChipStyle}"
                                    Command="{Binding FilterCommand}"
                                    CommandParameter="Accesorios"/>
                            <Button Text="Sets"
                                    Style="{StaticResource FilterChipStyle}"
                                    Command="{Binding FilterCommand}"
                                    CommandParameter="Sets"/>
                            <Button Text="Zapatos"
                                    Style="{StaticResource FilterChipStyle}"
                                    Command="{Binding FilterCommand}"
                                    CommandParameter="Zapatos"/>
                        </HorizontalStackLayout>
                    </ScrollView>

                    <Border Grid.Column="1"
                            Style="{StaticResource CardStyle}"
                            Padding="10,6"
                            Margin="8,0,0,0">
                        <HorizontalStackLayout Spacing="6">
                            <Label Text="&#xe8b6;" FontFamily="MaterialIcons"
                                   FontSize="16" TextColor="{StaticResource TextMuted}"
                                   VerticalOptions="Center"/>
                            <Entry Style="{StaticResource SearchEntryStyle}"
                                   Placeholder="Buscar producto..."
                                   Text="{Binding SearchText}"
                                   WidthRequest="140"/>
                        </HorizontalStackLayout>
                    </Border>

                </Grid>

                <CollectionView
                    Grid.Row="2"
                    ItemsSource="{Binding FilteredProducts}"
                    SelectionMode="Single"
                    SelectedItem="{Binding SelectedProduct}"
                    Margin="18,0,18,0">
                    <CollectionView.ItemsLayout>
                        <GridItemsLayout Orientation="Vertical"
                                         Span="3"
                                         HorizontalItemSpacing="10"
                                         VerticalItemSpacing="10"/>
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="m:ProductItem">
                            <Border Style="{StaticResource CardStyle}"
                                    Margin="0,0,0,2">
                                <Grid RowDefinitions="72,Auto">

                                    <Border Grid.Row="0"
                                            BackgroundColor="{Binding IconBg}"
                                            StrokeShape="RoundRectangle 12,12,0,0"
                                            Stroke="Transparent"
                                            StrokeThickness="0">
                                        <Label Text="{Binding Icon}"
                                               FontFamily="MaterialIcons"
                                               FontSize="30"
                                               TextColor="{StaticResource PinkPrimary}"
                                               HorizontalOptions="Center"
                                               VerticalOptions="Center"/>
                                    </Border>

                                    <VerticalStackLayout Grid.Row="1" Padding="9,6,9,10" Spacing="2">
                                        <Label Text="{Binding Category}"
                                               Style="{StaticResource SectionLabelStyle}"/>
                                        <Label Text="{Binding Name}"
                                               FontSize="11" FontAttributes="Bold"
                                               TextColor="{StaticResource TextMain}"
                                               LineBreakMode="TailTruncation"
                                               MaxLines="2"/>
                                        <Grid ColumnDefinitions="*,Auto" Margin="0,2,0,0">
                                            <Label Grid.Column="0"
                                                   Text="{Binding PriceFormatted}"
                                                   Style="{StaticResource PriceStyle}"/>
                                            <Label Grid.Column="1"
                                                   Text="{Binding Badge}"
                                                   Style="{StaticResource BadgeTextStyle}"
                                                   IsVisible="{Binding HasBadge}"
                                                   VerticalOptions="Center"/>
                                        </Grid>
                                        <Label Text="{Binding Sizes}"
                                               Style="{StaticResource CaptionStyle}"/>
                                    </VerticalStackLayout>

                                </Grid>

                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:PosViewModel}}, Path=AddToCartCommand}"
                                        CommandParameter="{Binding .}"/>
                                </Border.GestureRecognizers>

                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
            </Grid>

            <Border Grid.Row="3"
                        BackgroundColor="{StaticResource White}"
                        StrokeShape="Rectangle"
                        Stroke="{StaticResource BorderSoft}"
                        StrokeThickness="1"
                        Padding="14,0"
                        HeightRequest="28">
                <HorizontalStackLayout Spacing="16" VerticalOptions="Center">
                    <HorizontalStackLayout Spacing="5">
                        <Ellipse Style="{StaticResource StatusDotStyle}"/>
                        <Label Text="{Binding StatusConnection}"
                                   Style="{StaticResource CaptionStyle}"
                                   VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                    <Label Text="&#xf022;" FontFamily="MaterialIcons"
                               FontSize="13" TextColor="{StaticResource TextMuted}"
                               VerticalOptions="Center"/>
                    <Label Text="Impresora lista"
                               Style="{StaticResource CaptionStyle}"
                               VerticalOptions="Center"/>
                    <Label Text="&#xe227;" FontFamily="MaterialIcons"
                               FontSize="13" TextColor="{StaticResource TextMuted}"
                               VerticalOptions="Center"/>
                    <Label Text="{Binding CashDrawerLabel}"
                               Style="{StaticResource CaptionStyle}"
                               VerticalOptions="Center"/>
                    <Label Style="{StaticResource CaptionStyle}"
                               Text="{Binding ShiftLabel}"
                               HorizontalOptions="EndAndExpand"
                               VerticalOptions="Center"/>
                </HorizontalStackLayout>
            </Border>

        </Grid>

        <Grid
                Grid.Column="2"
                WidthRequest="300"
                RowDefinitions="Auto,*,Auto,Auto"
                BackgroundColor="{StaticResource White}">

            <VerticalStackLayout Grid.Row="0" Padding="14,14,14,10" Spacing="8">

                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="4">
                    <Button Grid.Column="0" Text="Venta"
                                Style="{StaticResource TabButtonActiveStyle}"
                                Command="{Binding SetModeCommand}"
                                CommandParameter="Venta"/>
                    <Button Grid.Column="1" Text="Apartado"
                                Style="{StaticResource TabButtonStyle}"
                                Command="{Binding SetModeCommand}"
                                CommandParameter="Apartado"/>
                    <Button Grid.Column="2" Text="Envío"
                                Style="{StaticResource TabButtonStyle}"
                                Command="{Binding SetModeCommand}"
                                CommandParameter="Envío"/>
                </Grid>

                <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                    <VerticalStackLayout Grid.Column="0" Spacing="1">
                        <Label Text="{Binding OrderTitle}"
                                   Style="{StaticResource SubtitleStyle}"/>
                        <Label Text="{Binding OrderMeta}"
                                   Style="{StaticResource CaptionStyle}"/>
                    </VerticalStackLayout>
                    <Button Grid.Column="1" Text="&#xe8ad;" FontFamily="MaterialIcons" Style="{StaticResource IconButtonStyle}" Margin="0,0,4,0"/>
                    <Button Grid.Column="2" Text="&#xe5d4;" FontFamily="MaterialIcons" Style="{StaticResource IconButtonStyle}" Margin="0,0,4,0"/>
                    <Button Grid.Column="3" Text="&#xe5cd;" FontFamily="MaterialIcons" Style="{StaticResource IconButtonStyle}" Command="{Binding ClearCartCommand}"/>
                </Grid>

                <Border Style="{StaticResource CardPinkStyle}">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <Label Grid.Column="0" Text="&#xe7fd;" FontFamily="MaterialIcons" FontSize="20" TextColor="{StaticResource PinkDark}" VerticalOptions="Center" Margin="0,0,8,0"/>
                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                            <Label Text="{Binding CustomerName}" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource TextMain}"/>
                            <HorizontalStackLayout Spacing="4">
                                <Border BackgroundColor="{StaticResource PinkSoft}" StrokeShape="RoundRectangle 10" Stroke="Transparent" Padding="5,1">
                                    <Label Text="{Binding CustomerTier}" Style="{StaticResource BadgeTextStyle}"/>
                                </Border>
                                <Border BackgroundColor="{StaticResource WarningLight}" StrokeShape="RoundRectangle 10" Stroke="Transparent" Padding="5,1">
                                    <Label Text="{Binding CustomerPoints}" FontSize="9" FontAttributes="Bold" TextColor="{StaticResource Warning}"/>
                                </Border>
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                        <Label Grid.Column="2" Text="&#xe5cc;" FontFamily="MaterialIcons" FontSize="14" TextColor="{StaticResource TextMuted}" VerticalOptions="Center"/>
                    </Grid>
                </Border>

            </VerticalStackLayout>

            <ScrollView Grid.Row="1" Padding="12,4">
                <VerticalStackLayout Spacing="6">
                    <CollectionView ItemsSource="{Binding CartItems}" SelectionMode="None">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="m:CartItem">
                                <Border Style="{StaticResource CartItemStyle}" Margin="0,0,0,6">
                                    <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto">
                                        <Border Grid.Column="0" Style="{StaticResource ProductIconBoxStyle}" Margin="0,0,8,0">
                                            <Label Text="{Binding Icon}" FontFamily="MaterialIcons" FontSize="18" TextColor="{StaticResource PinkPrimary}" HorizontalOptions="Center" VerticalOptions="Center"/>
                                        </Border>
                                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="1">
                                            <Label Text="{Binding Name}" FontSize="10" FontAttributes="Bold" TextColor="{StaticResource TextMain}" LineBreakMode="TailTruncation"/>
                                            <Label Text="{Binding Variant}" Style="{StaticResource CaptionStyle}"/>
                                        </VerticalStackLayout>
                                        <HorizontalStackLayout Grid.Column="2" Spacing="3" VerticalOptions="Center" Margin="4,0">
                                            <Button Text="−" Style="{StaticResource QtyButtonStyle}" Command="{Binding Source={RelativeSource AncestorType={x:Type vm:PosViewModel}}, Path=DecreaseQtyCommand}" CommandParameter="{Binding .}"/>
                                            <Label Text="{Binding Quantity}" FontSize="11" FontAttributes="Bold" TextColor="{StaticResource TextMain}" VerticalOptions="Center" WidthRequest="16" HorizontalTextAlignment="Center"/>
                                            <Button Text="+" Style="{StaticResource QtyButtonStyle}" Command="{Binding Source={RelativeSource AncestorType={x:Type vm:PosViewModel}}, Path=IncreaseQtyCommand}" CommandParameter="{Binding .}"/>
                                        </HorizontalStackLayout>
                                        <Label Grid.Column="3" Text="{Binding TotalFormatted}" Style="{StaticResource PriceStyle}" VerticalOptions="Center" Margin="4,0"/>
                                        <Button Grid.Column="4" Text="&#xe872;" FontFamily="MaterialIcons" FontSize="14" TextColor="{StaticResource Danger}" BackgroundColor="Transparent" BorderWidth="0" WidthRequest="28" HeightRequest="28" Padding="0" VerticalOptions="Center" Command="{Binding Source={RelativeSource AncestorType={x:Type vm:PosViewModel}}, Path=RemoveFromCartCommand}" CommandParameter="{Binding .}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <Border Style="{StaticResource NoteSuccessStyle}" IsVisible="{Binding HasPointsToEarn}">
                        <HorizontalStackLayout Spacing="6">
                            <Label Text="&#xe838;" FontFamily="MaterialIcons" FontSize="14" TextColor="{StaticResource Success}" VerticalOptions="Center"/>
                            <Label Text="{Binding PointsEarnedMessage}" FontSize="10" TextColor="{StaticResource Success}" VerticalOptions="Center"/>
                        </HorizontalStackLayout>
                    </Border>
                </VerticalStackLayout>
            </ScrollView>

            <VerticalStackLayout Grid.Row="2" Padding="14,4,14,0" Spacing="4">
                <BoxView Style="{StaticResource DividerStyle}"/>
                <Grid ColumnDefinitions="*,Auto">
                    <Label Grid.Column="0" Text="Subtotal" Style="{StaticResource CaptionStyle}"/>
                    <Label Grid.Column="1" Text="{Binding SubtotalFormatted}" Style="{StaticResource CaptionStyle}"/>
                </Grid>
                <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding HasDiscount}">
                    <Label Grid.Column="0" Text="{Binding DiscountLabel}" FontSize="11" TextColor="{StaticResource Danger}"/>
                    <Label Grid.Column="1" Text="{Binding DiscountFormatted}" FontSize="11" TextColor="{StaticResource Danger}"/>
                </Grid>
                <Grid ColumnDefinitions="*,Auto">
                    <Label Grid.Column="0" Text="IVA incluido en precio" Style="{StaticResource CaptionStyle}"/>
                    <Label Grid.Column="1" Text="—" Style="{StaticResource CaptionStyle}"/>
                </Grid>
                <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                    <Label Grid.Column="0" Text="Total a pagar" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource TextMain}" VerticalOptions="Center"/>
                    <Label Grid.Column="1" Text="{Binding TotalFormatted}" Style="{StaticResource TotalStyle}"/>
                </Grid>
            </VerticalStackLayout>

            <VerticalStackLayout Grid.Row="3" Padding="14,10,14,16" Spacing="8">
                <Label Text="Forma de pago" Style="{StaticResource SectionLabelStyle}"/>
                <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="5">
                    <Border Grid.Column="0" BackgroundColor="{Binding PaymentBgCard}" StrokeShape="RoundRectangle 8" Stroke="{Binding PaymentBorderCard}" StrokeThickness="1" Padding="6,7">
                        <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                            <Label Text="&#xe870;" FontFamily="MaterialIcons" FontSize="16" TextColor="{StaticResource PinkDark}" HorizontalOptions="Center"/>
                            <Label Text="Tarjeta" FontSize="9" FontAttributes="Bold" TextColor="{StaticResource TextMain}" HorizontalOptions="Center"/>
                        </VerticalStackLayout>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SetPaymentMethodCommand}" CommandParameter="Tarjeta"/>
                        </Border.GestureRecognizers>
                    </Border>
                    <Border Grid.Column="1" BackgroundColor="{StaticResource White}" StrokeShape="RoundRectangle 8" Stroke="{StaticResource BorderSoft}" StrokeThickness="1" Padding="6,7">
                        <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                            <Label Text="&#xe227;" FontFamily="MaterialIcons" FontSize="16" TextColor="{StaticResource TextMuted}" HorizontalOptions="Center"/>
                            <Label Text="Efectivo" FontSize="9" FontAttributes="Bold" TextColor="{StaticResource TextMuted}" HorizontalOptions="Center"/>
                        </VerticalStackLayout>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SetPaymentMethodCommand}" CommandParameter="Efectivo"/>
                        </Border.GestureRecognizers>
                    </Border>
                    <Border Grid.Column="2" BackgroundColor="{StaticResource White}" StrokeShape="RoundRectangle 8" Stroke="{StaticResource BorderSoft}" StrokeThickness="1" Padding="6,7">
                        <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                            <Label Text="&#xe32c;" FontFamily="MaterialIcons" FontSize="16" TextColor="{StaticResource TextMuted}" HorizontalOptions="Center"/>
                            <Label Text="CoDi" FontSize="9" FontAttributes="Bold" TextColor="{StaticResource TextMuted}" HorizontalOptions="Center"/>
                        </VerticalStackLayout>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SetPaymentMethodCommand}" CommandParameter="CoDi"/>
                        </Border.GestureRecognizers>
                    </Border>
                    <Border Grid.Column="3" BackgroundColor="{StaticResource White}" StrokeShape="RoundRectangle 8" Stroke="{StaticResource BorderSoft}" StrokeThickness="1" Padding="6,7">
                        <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                            <Label Text="&#xe8a9;" FontFamily="MaterialIcons" FontSize="16" TextColor="{StaticResource TextMuted}" HorizontalOptions="Center"/>
                            <Label Text="PayPal" FontSize="9" FontAttributes="Bold" TextColor="{StaticResource TextMuted}" HorizontalOptions="Center"/>
                        </VerticalStackLayout>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SetPaymentMethodCommand}" CommandParameter="PayPal"/>
                        </Border.GestureRecognizers>
                    </Border>
                </Grid>

                <Button Text="{Binding ChargeButtonLabel}" Style="{StaticResource PrimaryButtonStyle}" HorizontalOptions="Fill" Command="{Binding ChargeCommand}" IsEnabled="{Binding CanCharge}"/>
                <Button Text="Convertir en apartado" Style="{StaticResource SecondaryButtonStyle}" HorizontalOptions="Fill" Command="{Binding ConvertToLayawayCommand}"/>
            </VerticalStackLayout>

        </Grid>
    </Grid>
    </Grid>
</ContentPage>