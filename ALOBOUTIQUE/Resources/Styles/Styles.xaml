<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- ══════════════════════════════════════════
         MERGE COLORS
         Asegúrate de que Colors.xaml esté mergeado
         antes de este archivo en App.xaml
    ══════════════════════════════════════════ -->

    <!-- ───────────────────────────────────────
         LABELS
    ─────────────────────────────────────────── -->

    <!-- Título principal (serif itálica, estilo boutique) -->
    <Style x:Key="TitleStyle" TargetType="Label">
        <Setter Property="FontFamily" Value="CormorantGaramond-BoldItalic"/>
        <Setter Property="FontSize" Value="22"/>
        <Setter Property="TextColor" Value="{StaticResource TextMain}"/>
    </Style>

    <!-- Subtítulo de sección -->
    <Style x:Key="SubtitleStyle" TargetType="Label">
        <Setter Property="FontFamily" Value="CormorantGaramond-Italic"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="TextColor" Value="{StaticResource TextMain}"/>
    </Style>

    <!-- Label de cuerpo normal -->
    <Style x:Key="BodyStyle" TargetType="Label">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="TextColor" Value="{StaticResource TextMain}"/>
    </Style>

    <!-- Label secundario / muted -->
    <Style x:Key="CaptionStyle" TargetType="Label">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="TextColor" Value="{StaticResource TextMuted}"/>
    </Style>

    <!-- Label de hint / placeholder visible -->
    <Style x:Key="HintStyle" TargetType="Label">
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="TextColor" Value="{StaticResource TextHint}"/>
    </Style>

    <!-- Etiqueta de sección (ALL CAPS, espaciado) -->
    <Style x:Key="SectionLabelStyle" TargetType="Label">
        <Setter Property="FontSize" Value="9"/>
        <Setter Property="TextColor" Value="{StaticResource TextMuted}"/>
        <Setter Property="FontAttributes" Value="Bold"/>
        <Setter Property="CharacterSpacing" Value="2"/>
        <Setter Property="TextTransform" Value="Uppercase"/>
    </Style>

    <!-- Precio destacado -->
    <Style x:Key="PriceStyle" TargetType="Label">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontAttributes" Value="Bold"/>
        <Setter Property="TextColor" Value="{StaticResource PinkDark}"/>
    </Style>

    <!-- Total grande en cobro -->
    <Style x:Key="TotalStyle" TargetType="Label">
        <Setter Property="FontFamily" Value="CormorantGaramond-Bold"/>
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="FontAttributes" Value="Bold"/>
        <Setter Property="TextColor" Value="{StaticResource TextMain}"/>
    </Style>

    <!-- Badge texto -->
    <Style x:Key="BadgeTextStyle" TargetType="Label">
        <Setter Property="FontSize" Value="9"/>
        <Setter Property="FontAttributes" Value="Bold"/>
        <Setter Property="TextColor" Value="{StaticResource PinkDeep}"/>
    </Style>

    <!-- ───────────────────────────────────────
         BRAND LABEL (nombre boutique en sidebar)
    ─────────────────────────────────────────── -->
    <Style x:Key="BrandStyle" TargetType="Label">
        <Setter Property="FontFamily" Value="CormorantGaramond-BoldItalic"/>
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="TextColor" Value="{StaticResource PinkDeep}"/>
        <Setter Property="CharacterSpacing" Value="0.5"/>
    </Style>

    <!-- ───────────────────────────────────────
         BOTONES
    ─────────────────────────────────────────── -->

    <!-- Botón primario (cobrar, acción principal) -->
    <Style x:Key="PrimaryButtonStyle" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource PinkPrimary}"/>
        <Setter Property="TextColor" Value="{StaticResource White}"/>
        <Setter Property="FontAttributes" Value="Bold"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Padding" Value="14,10"/>
        <Setter Property="HeightRequest" Value="44"/>
        <Setter Property="Shadow">
            <Setter.Value>
                <Shadow Brush="{StaticResource PinkPrimary}" Offset="0,3" Radius="8" Opacity="0.35"/>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Botón secundario (apartado, acciones secundarias) -->
    <Style x:Key="SecondaryButtonStyle" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource White}"/>
        <Setter Property="TextColor" Value="{StaticResource TextMain}"/>
        <Setter Property="FontAttributes" Value="Bold"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Padding" Value="14,10"/>
        <Setter Property="HeightRequest" Value="40"/>
        <Setter Property="BorderColor" Value="{StaticResource BorderMid}"/>
        <Setter Property="BorderWidth" Value="1"/>
    </Style>

    <!-- Botón de icono (cuadrado, solo ícono) -->
    <Style x:Key="IconButtonStyle" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource White}"/>
        <Setter Property="TextColor" Value="{StaticResource TextMuted}"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="6"/>
        <Setter Property="WidthRequest" Value="34"/>
        <Setter Property="HeightRequest" Value="34"/>
        <Setter Property="BorderColor" Value="{StaticResource BorderSoft}"/>
        <Setter Property="BorderWidth" Value="1"/>
    </Style>

    <!-- Botón de cantidad (+/-) -->
    <Style x:Key="QtyButtonStyle" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource White}"/>
        <Setter Property="TextColor" Value="{StaticResource PinkDark}"/>
        <Setter Property="FontAttributes" Value="Bold"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="WidthRequest" Value="26"/>
        <Setter Property="HeightRequest" Value="26"/>
        <Setter Property="BorderColor" Value="{StaticResource PinkLight}"/>
        <Setter Property="BorderWidth" Value="1"/>
    </Style>

    <!-- Botón de filtro/chip (toggle) -->
    <Style x:Key="FilterChipStyle" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource White}"/>
        <Setter Property="TextColor" Value="{StaticResource TextMuted}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontAttributes" Value="Bold"/>
        <Setter Property="CornerRadius" Value="20"/>
        <Setter Property="Padding" Value="12,5"/>
        <Setter Property="BorderColor" Value="{StaticResource BorderSoft}"/>
        <Setter Property="BorderWidth" Value="1"/>
    </Style>

    <!-- Botón de filtro/chip ACTIVO -->
    <Style x:Key="FilterChipActiveStyle" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource PinkPrimary}"/>
        <Setter Property="TextColor" Value="{StaticResource White}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontAttributes" Value="Bold"/>
        <Setter Property="CornerRadius" Value="20"/>
        <Setter Property="Padding" Value="12,5"/>
        <Setter Property="BorderColor" Value="{StaticResource PinkPrimary}"/>
        <Setter Property="BorderWidth" Value="1"/>
    </Style>

    <!-- Botón de tab (Venta / Apartado / Envío) -->
    <Style x:Key="TabButtonStyle" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource White}"/>
        <Setter Property="TextColor" Value="{StaticResource TextMuted}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontAttributes" Value="Bold"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="8,5"/>
        <Setter Property="BorderColor" Value="{StaticResource BorderSoft}"/>
        <Setter Property="BorderWidth" Value="1"/>
    </Style>

    <!-- Botón de tab ACTIVO -->
    <Style x:Key="TabButtonActiveStyle" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource PinkPrimary}"/>
        <Setter Property="TextColor" Value="{StaticResource White}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontAttributes" Value="Bold"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="8,5"/>
        <Setter Property="BorderColor" Value="{StaticResource PinkPrimary}"/>
        <Setter Property="BorderWidth" Value="1"/>
    </Style>

    <!-- ───────────────────────────────────────
         ENTRADAS DE TEXTO
    ─────────────────────────────────────────── -->

    <Style x:Key="SearchEntryStyle" TargetType="Entry">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="TextColor" Value="{StaticResource TextMain}"/>
        <Setter Property="PlaceholderColor" Value="{StaticResource TextHint}"/>
        <Setter Property="BackgroundColor" Value="Transparent"/>
        <Setter Property="VerticalOptions" Value="Center"/>
    </Style>

    <!-- ───────────────────────────────────────
         FRAMES / BORDES (Border en MAUI)
    ─────────────────────────────────────────── -->

    <!-- Tarjeta blanca base -->
    <Style x:Key="CardStyle" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{StaticResource White}"/>
        <Setter Property="StrokeShape" Value="RoundRectangle 12"/>
        <Setter Property="Stroke" Value="{StaticResource BorderSoft}"/>
        <Setter Property="StrokeThickness" Value="1"/>
        <Setter Property="Padding" Value="0"/>
    </Style>

    <!-- Tarjeta con fondo rosa ghost (sidebar, cliente) -->
    <Style x:Key="CardPinkStyle" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{StaticResource PinkGhost}"/>
        <Setter Property="StrokeShape" Value="RoundRectangle 10"/>
        <Setter Property="Stroke" Value="{StaticResource BorderSoft}"/>
        <Setter Property="StrokeThickness" Value="1"/>
        <Setter Property="Padding" Value="10"/>
    </Style>

    <!-- Ítem de carrito -->
    <Style x:Key="CartItemStyle" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{StaticResource RoseGhost}"/>
        <Setter Property="StrokeShape" Value="RoundRectangle 10"/>
        <Setter Property="Stroke" Value="{StaticResource BorderSoft}"/>
        <Setter Property="StrokeThickness" Value="1"/>
        <Setter Property="Padding" Value="10,8"/>
    </Style>

    <!-- Panel de pago -->
    <Style x:Key="PaymentPanelStyle" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{StaticResource White}"/>
        <Setter Property="StrokeShape" Value="RoundRectangle 12"/>
        <Setter Property="Stroke" Value="{StaticResource BorderSoft}"/>
        <Setter Property="StrokeThickness" Value="1"/>
        <Setter Property="Padding" Value="12"/>
    </Style>

    <!-- Nota / alerta verde (puntos Peka Club) -->
    <Style x:Key="NoteSuccessStyle" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{StaticResource SuccessLight}"/>
        <Setter Property="StrokeShape" Value="RoundRectangle 8"/>
        <Setter Property="Stroke" Value="{StaticResource Success}"/>
        <Setter Property="StrokeThickness" Value="0.5"/>
        <Setter Property="Padding" Value="10,7"/>
    </Style>

    <!-- Icono de producto (cuadro redondeado) -->
    <Style x:Key="ProductIconBoxStyle" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{StaticResource PinkGhost}"/>
        <Setter Property="StrokeShape" Value="RoundRectangle 10"/>
        <Setter Property="Stroke" Value="Transparent"/>
        <Setter Property="StrokeThickness" Value="0"/>
        <Setter Property="WidthRequest" Value="36"/>
        <Setter Property="HeightRequest" Value="36"/>
        <Setter Property="HorizontalOptions" Value="Start"/>
    </Style>

    <!-- Badge (nuevo, low stock, sale) -->
    <Style x:Key="BadgeNewStyle" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{StaticResource PinkSoft}"/>
        <Setter Property="StrokeShape" Value="RoundRectangle 10"/>
        <Setter Property="Stroke" Value="Transparent"/>
        <Setter Property="StrokeThickness" Value="0"/>
        <Setter Property="Padding" Value="5,1"/>
    </Style>

    <Style x:Key="BadgeWarningStyle" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{StaticResource WarningLight}"/>
        <Setter Property="StrokeShape" Value="RoundRectangle 10"/>
        <Setter Property="Stroke" Value="Transparent"/>
        <Setter Property="StrokeThickness" Value="0"/>
        <Setter Property="Padding" Value="5,1"/>
    </Style>

    <Style x:Key="BadgeDangerStyle" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{StaticResource DangerLight}"/>
        <Setter Property="StrokeShape" Value="RoundRectangle 10"/>
        <Setter Property="Stroke" Value="Transparent"/>
        <Setter Property="StrokeThickness" Value="0"/>
        <Setter Property="Padding" Value="5,1"/>
    </Style>

    <!-- ───────────────────────────────────────
         SEPARADORES
    ─────────────────────────────────────────── -->

    <Style x:Key="DividerStyle" TargetType="BoxView">
        <Setter Property="HeightRequest" Value="1"/>
        <Setter Property="BackgroundColor" Value="{StaticResource BorderSoft}"/>
        <Setter Property="HorizontalOptions" Value="Fill"/>
        <Setter Property="Margin" Value="0,4"/>
    </Style>

    <!-- ───────────────────────────────────────
         SIDEBAR / RAIL
    ─────────────────────────────────────────── -->

    <!-- Ítem de navegación (normal) -->
    <Style x:Key="NavItemStyle" TargetType="Border">
        <Setter Property="BackgroundColor" Value="Transparent"/>
        <Setter Property="StrokeShape" Value="RoundRectangle 8"/>
        <Setter Property="Stroke" Value="Transparent"/>
        <Setter Property="StrokeThickness" Value="0"/>
        <Setter Property="Padding" Value="10,7"/>
    </Style>

    <!-- Ítem de navegación ACTIVO -->
    <Style x:Key="NavItemActiveStyle" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{StaticResource PinkLight}"/>
        <Setter Property="StrokeShape" Value="RoundRectangle 8"/>
        <Setter Property="Stroke" Value="Transparent"/>
        <Setter Property="StrokeThickness" Value="0"/>
        <Setter Property="Padding" Value="10,7"/>
    </Style>

    <!-- Avatar de cajera -->
    <Style x:Key="AvatarStyle" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{StaticResource PinkLight}"/>
        <Setter Property="StrokeShape" Value="Ellipse"/>
        <Setter Property="Stroke" Value="Transparent"/>
        <Setter Property="StrokeThickness" Value="0"/>
        <Setter Property="WidthRequest" Value="34"/>
        <Setter Property="HeightRequest" Value="34"/>
    </Style>

    <!-- ───────────────────────────────────────
         STATUS BAR
    ─────────────────────────────────────────── -->

    <Style x:Key="StatusDotStyle" TargetType="Ellipse">
        <Setter Property="Fill" Value="#29C940"/>
        <Setter Property="WidthRequest" Value="7"/>
        <Setter Property="HeightRequest" Value="7"/>
        <Setter Property="VerticalOptions" Value="Center"/>
    </Style>

</ResourceDictionary>
